{
  "expo": {
    "name": "Mon-Go",
    "slug": "Mon-Go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mongo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tulubyev.mongo",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна для распознавания текста на монгольском языке (OCR переводчик)",
        "NSMicrophoneUsageDescription": "Микрофон нужен для живого переводчика — запись речи на монгольском",
        "NSLocationWhenInUseUsageDescription": "Местоположение нужно для отображения вашей позиции на карте Монголии",
        "NSPhotoLibraryUsageDescription": "Доступ к галерее нужен для выбора фото для OCR переводчика",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tulubyev.mongo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к галерее нужен для выбора фото для OCR переводчика",
          "cameraPermission": "Камера нужна для распознавания текста на монгольском языке"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.2"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2eb411cf-cd12-4959-9e37-fed0e7f2755f"
      }
    }
  }
}
